   name="StepToken";
   short_nm="StpTkn";
   tags=;
   desc=;
   version {
    major=0;
    minor=0;
    step=0;
   };
   author=;
   email=;
   flags=NO_STOP_STEP|OBJS_UPDT_GUI;
