    UserScript @[1] {
     name="UserScript_Readthelaborator_etVarstatusendl";
     desc=;
     flags=0;
     code_string=;
     script {
      expr="// Read the laboratory controls. Bounds keep the live display legible and
// the softmax numerically stable, and are written back to the control panel.
