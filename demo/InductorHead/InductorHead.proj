     local_vars {
      name="local_vars";
      el_typ=ProgVar;
      el_def=0;
     };
    };
    UserScript @[1] {
     name="UserScript_Readthelaborator_etVarstatusendl";
     desc=;
     flags=CAN_REVERT_TO_CODE;
     code_string="// Read the laboratory controls. Bounds keep the live display legible and
// the softmax numerically stable, and are written back to the control panel.
BpProject* ih_project = project;
Program* ih_cfg = ih_project->programs[\"RunCircuit\"];
BpNetwork* ih_net = ih_project->networks[\"InductionCircuit\"];
DataTable* ih_sequence = ih_project->data[\"Sequence\"];
DataTable* ih_states = ih_project->data[\"CircuitState\"];
DataTable* ih_results = ih_project->data[\"Experiments\"];
int ih_n = ih_cfg->GetVar(\"sequence_length\");
int ih_v = ih_cfg->GetVar(\"vocabulary_size\");
int ih_seed = ih_cfg->GetVar(\"seed\");
double ih_temp = ih_cfg->GetVar(\"temperature\");
double ih_noise = ih_cfg->GetVar(\"noise\");
int ih_cursor = ih_cfg->GetVar(\"cursor\");
bool ih_ablate_previous = ih_cfg->GetVar(\"ablate_previous\");
bool ih_ablate_induction = ih_cfg->GetVar(\"ablate_induction\");
if(ih_n < 5) ih_n = 5;
if(ih_n > 32) ih_n = 32;
if(ih_v < 4) ih_v = 4;
if(ih_v > 16) ih_v = 16;
if(ih_temp < 0.02) ih_temp = 0.02;
if(ih_temp > 5.0) ih_temp = 5.0;
if(ih_noise < 0.0) ih_noise = 0.0;
if(ih_noise > 1.0) ih_noise = 1.0;
if(ih_seed < 1) ih_seed = 1;
if(ih_seed > 1000000) ih_seed = 1000000;
if(ih_cursor < 1) ih_cursor = 1;
if(ih_cursor >= ih_n) ih_cursor = ih_n - 1;
ih_cfg->SetVar(\"sequence_length\", ih_n);
ih_cfg->SetVar(\"vocabulary_size\", ih_v);
ih_cfg->SetVar(\"temperature\", ih_temp);
ih_cfg->SetVar(\"noise\", ih_noise);
ih_cfg->SetVar(\"seed\", ih_seed);
ih_cfg->SetVar(\"cursor\", ih_cursor);
// Park-Miller RNG using Schrage's overflow-free integer recurrence.
// Fisher-Yates chooses a fresh vocabulary permutation for each seed.
int_Matrix ih_permutation;
ih_permutation.SetGeom(1, ih_v);
int ih_rng = ih_seed;
int ih_a;
for(ih_a = 0; ih_a < ih_v; ih_a++) ih_permutation[ih_a] = ih_a;
for(ih_a = ih_v - 1; ih_a > 0; ih_a--) {
  ih_rng = 16807 * (ih_rng % 127773) - 2836 * (ih_rng / 127773);
  if(ih_rng <= 0) ih_rng += 2147483647;
  int ih_swap = ih_rng % (ih_a + 1);
  int ih_tmp = ih_permutation[ih_a];
  ih_permutation[ih_a] = ih_permutation[ih_swap];
  ih_permutation[ih_swap] = ih_tmp;
}
int ih_period = ih_n / 2;
if(ih_period > ih_v - 1) ih_period = ih_v - 1;
ih_sequence->RemoveAllRows();
ih_sequence->AddRows(ih_n);
for(ih_a = 0; ih_a < ih_n; ih_a++) {
  int ih_token = ih_permutation[ih_a % ih_period];
  // Keep the first exemplar and final query intact. Corrupt intermediate
  // repetitions with the held-out distractor token at the requested rate.
  ih_rng = 16807 * (ih_rng % 127773) - 2836 * (ih_rng / 127773);
  if(ih_rng <= 0) ih_rng += 2147483647;
  double ih_draw = ih_rng / 2147483647.0;
  if(ih_a >= ih_period && ih_a < ih_n - 1 && ih_draw < ih_noise)
    ih_token = ih_permutation[ih_v - 1];
  ih_sequence->SetVal(ih_a, \"position\", ih_a);
  ih_sequence->SetVal(ih_token, \"token\", ih_a);
  ih_sequence->SetVal(String(ih_token), \"label\", ih_a);
  int ih_next_token = ih_permutation[(ih_a + 1) % ih_period];
  ih_sequence->SetVal(ih_next_token, \"next_token\", ih_a);
}
ih_cursor = ih_n - 1;
ih_cfg->SetVar(\"cursor\", ih_cursor);
// Exact constructed two-head attention circuit. Head 1 copies the previous
// token embedding into a separate key subspace. Head 2 compares the current
// token query to that subspace, applies a causal softmax and copies values.
int_Matrix ih_tokens;
float_Matrix ih_embeddings;
float_Matrix ih_keys;
float_Matrix ih_attention;
float_Matrix ih_values;
float_Matrix ih_prediction;
ih_tokens.SetGeom(1, ih_n);
ih_embeddings.SetGeom(2, ih_n, ih_v);
ih_keys.SetGeom(2, ih_n, ih_v);
ih_attention.SetGeom(2, ih_n, ih_n);
ih_values.SetGeom(2, ih_n, ih_v);
ih_prediction.SetGeom(1, ih_v);
ih_embeddings.InitVals(0.0);
ih_keys.InitVals(0.0);
ih_attention.InitVals(0.0);
ih_values.InitVals(0.0);
ih_prediction.InitVals(0.0);
int ih_i;
int ih_j;
int ih_k;
for(ih_i = 0; ih_i < ih_n; ih_i++) {
  ih_tokens[ih_i] = ih_sequence->GetVal(\"token\", ih_i);
  if(ih_tokens[ih_i] < 0 || ih_tokens[ih_i] >= ih_v) {
    ih_cfg->SetVar(\"status\", \"Token outside vocabulary. Generate a new sequence.\");
    ret_val = -1;
    return;
  }
  int ih_current_token = ih_tokens[ih_i];
  ih_embeddings[ih_i, ih_current_token] = 1.0;
  if(ih_i > 0 && !ih_ablate_previous) {
    int ih_previous_token = ih_tokens[ih_i - 1];
    ih_keys[ih_i, ih_previous_token] = 1.0;
  }
}
for(ih_i = 1; ih_i < ih_n; ih_i++) {
  double ih_total = 0.0;
  int ih_query_token = ih_tokens[ih_i];
  // j=0 has no predecessor key. The standard causal mask permits j<=i;
  // every future source j>i remains exactly zero.
  for(ih_j = 1; ih_j <= ih_i; ih_j++) {
    double ih_match = ih_keys[ih_j, ih_query_token];
    double ih_weight = exp((ih_match - 1.0) / ih_temp);
    ih_attention[ih_j, ih_i] = ih_weight;
    ih_total += ih_weight;
  }
  for(ih_j = 1; ih_j <= ih_i; ih_j++)
    ih_attention[ih_j, ih_i] = ih_attention[ih_j, ih_i] / ih_total;
}
for(ih_j = 1; ih_j <= ih_cursor; ih_j++) {
  double ih_mass = ih_attention[ih_j, ih_cursor];
  if(ih_ablate_induction) ih_mass = 0.0;
  int ih_value_token = ih_tokens[ih_j];
  ih_values[ih_j, ih_value_token] = ih_mass;
  ih_prediction[ih_value_token] += ih_mass;
}
int ih_predicted = -1;
double ih_best = 0.0;
for(ih_k = 0; ih_k < ih_v; ih_k++) {
  if(ih_prediction[ih_k] > ih_best) {
    ih_best = ih_prediction[ih_k];
    ih_predicted = ih_k;
  }
}
int ih_target = ih_sequence->GetVal(\"next_token\", ih_cursor);
ih_cfg->SetVar(\"prediction\", ih_predicted);
ih_cfg->SetVar(\"target\", ih_target);
ih_cfg->SetVar(\"confidence\", ih_best);
ih_cfg->SetVar(\"status\", \"Query \" + String(ih_tokens[ih_cursor]) +
  \" at position \" + String(ih_cursor) + \" predicts \" + String(ih_predicted) +
  \"; repeated-pattern target \" + String(ih_target));

// Keep inspectable DataTable matrices and real Network unit state in sync.
bool ih_resize_table = ih_states->data.size != 5;
if(!ih_resize_table) {
  DataCol* ih_first_column = ih_states->data[0];
  ih_resize_table = ih_first_column->cell_geom.dim(0) != ih_n ||
                    ih_first_column->cell_geom.dim(1) != ih_v;
}
if(ih_resize_table) {
  ih_states->RemoveAllCols();
  ih_states->NewColMatrix(DataCol::VT_FLOAT, \"TokenEmbeddings\", 2, ih_n, ih_v);
  ih_states->NewColMatrix(DataCol::VT_FLOAT, \"PreviousTokenKeys\", 2, ih_n, ih_v);
  ih_states->NewColMatrix(DataCol::VT_FLOAT, \"CausalAttention\", 2, ih_n, ih_n);
  ih_states->NewColMatrix(DataCol::VT_FLOAT, \"CopiedValues\", 2, ih_n, ih_v);
  ih_states->NewColMatrix(DataCol::VT_FLOAT, \"Prediction\", 1, ih_v);
  ih_states->AddRows(1);
 }
ih_states->SetValAsMatrix(ih_embeddings, \"TokenEmbeddings\", 0);
ih_states->SetValAsMatrix(ih_keys, \"PreviousTokenKeys\", 0);
ih_states->SetValAsMatrix(ih_attention, \"CausalAttention\", 0);
ih_states->SetValAsMatrix(ih_values, \"CopiedValues\", 0);
ih_states->SetValAsMatrix(ih_prediction, \"Prediction\", 0);

Layer* ih_token_layer = ih_net->layers[\"Token_Embeddings\"];
Layer* ih_key_layer = ih_net->layers[\"Previous_Token_Keys\"];
Layer* ih_query_layer = ih_net->layers[\"Current_Query\"];
Layer* ih_attn_layer = ih_net->layers[\"Causal_Attention\"];
Layer* ih_value_layer = ih_net->layers[\"Copied_Values\"];
Layer* ih_pred_layer = ih_net->layers[\"Next_Token_Prediction\"];
if(ih_token_layer->un_geom.x != ih_n || ih_token_layer->un_geom.y != ih_v ||
   ih_token_layer->n_units_built == 0) {
  ih_token_layer->SetLayerUnitGeom(ih_n, ih_v);
  ih_key_layer->SetLayerUnitGeom(ih_n, ih_v);
  ih_query_layer->SetLayerUnitGeom(1, ih_v);
  ih_attn_layer->SetLayerUnitGeom(ih_n, ih_n);
  ih_value_layer->SetLayerUnitGeom(ih_n, ih_v);
  ih_pred_layer->SetLayerUnitGeom(1, ih_v);
  ih_token_layer->SetAbsPos(0, 0, 0);
  ih_key_layer->SetAbsPos(0, ih_v + 3, 3);
  ih_query_layer->SetAbsPos(ih_n + 4, ih_v + 3, 3);
  ih_attn_layer->SetAbsPos(0, 2 * (ih_v + 3), 6);
  ih_value_layer->SetAbsPos(0, 2 * (ih_v + 3) + ih_n + 4, 9);
  ih_pred_layer->SetAbsPos(ih_n + 4, 2 * (ih_v + 3) + ih_n + 4, 12);
  ih_net->Build();
  ih_net->Init_Weights();
}
for(ih_i = 0; ih_i < 6; ih_i++) {
  Layer* ih_label_layer = ih_net->layers[ih_i];
  ih_label_layer->SetUnitNames(true);
}
for(ih_j = 0; ih_j < ih_n; ih_j++) {
  for(ih_k = 0; ih_k < ih_v; ih_k++) {
    ih_token_layer->GetUnitFlatXY(ih_j, ih_k)->act = ih_embeddings[ih_j, ih_k];
    ih_key_layer->GetUnitFlatXY(ih_j, ih_k)->act = ih_keys[ih_j, ih_k];
    ih_value_layer->GetUnitFlatXY(ih_j, ih_k)->act = ih_values[ih_j, ih_k];
    String ih_label = String(ih_j) + \":\" + String(ih_k);
    ih_token_layer->SetUnitNameIdx(ih_k * ih_n + ih_j, ih_label);
    ih_key_layer->SetUnitNameIdx(ih_k * ih_n + ih_j, ih_label);
    ih_value_layer->SetUnitNameIdx(ih_k * ih_n + ih_j, ih_label);
  }
  for(ih_i = 0; ih_i < ih_n; ih_i++) {
    ih_attn_layer->GetUnitFlatXY(ih_j, ih_i)->act = ih_attention[ih_j, ih_i];
    ih_attn_layer->SetUnitNameIdx(ih_i * ih_n + ih_j, String(ih_i) + \"<-\" + String(ih_j));
  }
}
for(ih_k = 0; ih_k < ih_v; ih_k++) {
  ih_query_layer->GetUnitIdx(ih_k)->act = (ih_k == ih_tokens[ih_cursor]);
  ih_pred_layer->GetUnitIdx(ih_k)->act = ih_prediction[ih_k];
  ih_query_layer->SetUnitNameIdx(ih_k, String(ih_k));
  ih_pred_layer->SetUnitNameIdx(ih_k, String(ih_k));
}
ih_net->UpdateAllViews();
ih_states->UpdateAllViews();
ih_sequence->UpdateAllViews();
if(taMisc::gui_active) {
  NetView* ih_view = ih_net->FindMakeView();
  ih_view->lay_layout = NetView::THREE_D;
  ih_view->unit_disp_mode = NetView::UDM_BLOCK;
  ih_view->unit_text_disp = NetView::UTD_NONE;
  ih_view->display = true;
  ih_view->font_sizes.layer = 0.0;
  ih_view->font_sizes.layer_min = 0.0;
  ih_view->font_sizes.net_name = 0.0;
  T3Panel* ih_frame = ih_view->GetFrame();
  ih_frame->SetColorScheme(T3Panel::WHITE_ON_BLACK);
  ih_frame->bg_color.Set(0.035, 0.055, 0.11);
  ih_frame->text_color.Set(0.86, 0.93, 1.0);
  ih_frame->UpdateAfterEdit();
  ih_net->SetViewVar(\"act\");
  ih_view->SetScaleData(false, 0.0, 1.0);
  // These annotations connect computational stages; they are not Bp synapses.
  ih_view->annotations.Reset();
  ih_view->AnnoteEndArrow(true, ih_n / 2.0, ih_v + 0.5, 0,
    0, 2.5, 3, 3.0, \"#22d3ee\", 0.018);
  ih_view->AnnoteEndArrow(true, ih_n / 2.0, 2 * ih_v + 3.5, 3,
    0, 2.5, 3, 3.0, \"#a78bfa\", 0.018);
  ih_view->AnnoteEndArrow(true, ih_n + 4, ih_v + 3, 3,
    -4, ih_v + 3, 3, 3.0, \"#fbbf24\", 0.018);
  ih_view->AnnoteEndArrow(true, ih_n / 2.0, 2 * (ih_v + 3) + ih_n + 0.5, 6,
    0, 3.5, 3, 3.0, \"#60a5fa\", 0.018);
  ih_view->AnnoteEndArrow(true, ih_n + 0.5, 2 * (ih_v + 3) + ih_n + 4 + ih_v / 2.0, 9,
    3.5, 0, 3, 3.0, \"#34d399\", 0.018);
  // Existing annotation rotations keep stage labels facing the saved camera.
  T3Annotation* ih_label_0 = ih_view->AnnoteText(true, \"01  Token embeddings\",
    0, -4, 0, 0.055, T3DataViewMain::LEFT, \"#cffafe\");
  ih_label_0->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_0->UpdateAfterEdit();
  T3Annotation* ih_label_1 = ih_view->AnnoteText(true, \"02  Previous-token keys\",
    0, ih_v - 1, 3, 0.055, T3DataViewMain::LEFT, \"#ddd6fe\");
  ih_label_1->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_1->UpdateAfterEdit();
  T3Annotation* ih_label_2 = ih_view->AnnoteText(true, \"03  Query\",
    ih_n + 3, ih_v - 1, 3, 0.045, T3DataViewMain::LEFT, \"#fde68a\");
  ih_label_2->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_2->UpdateAfterEdit();
  T3Annotation* ih_label_3 = ih_view->AnnoteText(true, \"04  Causal attention\",
    0, 2 * (ih_v + 3) - 4, 6, 0.055, T3DataViewMain::LEFT, \"#bfdbfe\");
  ih_label_3->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_3->UpdateAfterEdit();
  T3Annotation* ih_label_4 = ih_view->AnnoteText(true, \"05  Copied values\",
    0, 2 * (ih_v + 3) + ih_n, 9, 0.055, T3DataViewMain::LEFT, \"#a7f3d0\");
  ih_label_4->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_4->UpdateAfterEdit();
  T3Annotation* ih_label_5 = ih_view->AnnoteText(true, \"06  Prediction\",
    ih_n + 2, 2 * (ih_v + 3) + ih_n, 12, 0.045, T3DataViewMain::LEFT, \"#a7f3d0\");
  ih_label_5->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_5->UpdateAfterEdit();
  T3Annotation* ih_label_6 = ih_view->AnnoteText(true, \"INDUCTORHEAD | MATCH -> COPY\",
    0, 2 * (ih_v + 3) + ih_n + ih_v + 7, 12, 0.05, T3DataViewMain::LEFT, \"#67e8f9\");
  ih_label_6->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_6->UpdateAfterEdit();
  ih_view->UpdateDisplay();
  // Tilt the camera toward the token grids and frame all six stages.
  ih_frame->SaveCurView(0);
  ih_frame->SetCameraOrient(0, 1, 0, 0, -0.62);
  ih_frame->SetCameraPos(0, 0.55, 1.828, 1.241);
  ih_frame->SetCameraFocDist(0, 2.2);
  ih_frame->GoToSavedView(0);
  ih_frame->SaveCurView(0);
  ih_project->ctrl_panels[\"Laboratory\"]->EditPanel(true, true);
  MainWindowViewer* ih_browser = ih_project->GetDefaultProjectViewer();
  if(ih_browser != NULL) {
    // Existing saved-window geometry leaves room for the existing CSS console.
    ih_browser->SetUserData(\"view_win_lft\", 0.01);
    ih_browser->SetUserData(\"view_win_top\", 0.01);
    ih_browser->SetUserData(\"view_win_wd\", 0.98);
    ih_browser->SetUserData(\"view_win_ht\", 0.78);
    ih_browser->SetWinState();
    ih_browser->ViewWindow();
  }
}

cout << \"INDUCTOR \" << ih_cfg->GetVar(\"status\") << endl;
";
     script {
      expr="// Read the laboratory controls. Bounds keep the live display legible and
// the softmax numerically stable, and are written back to the control panel.
BpProject* ih_project = project;
Program* ih_cfg = ih_project->programs[\"RunCircuit\"];
BpNetwork* ih_net = ih_project->networks[\"InductionCircuit\"];
DataTable* ih_sequence = ih_project->data[\"Sequence\"];
DataTable* ih_states = ih_project->data[\"CircuitState\"];
DataTable* ih_results = ih_project->data[\"Experiments\"];
int ih_n = ih_cfg->GetVar(\"sequence_length\");
int ih_v = ih_cfg->GetVar(\"vocabulary_size\");
int ih_seed = ih_cfg->GetVar(\"seed\");
double ih_temp = ih_cfg->GetVar(\"temperature\");
double ih_noise = ih_cfg->GetVar(\"noise\");
int ih_cursor = ih_cfg->GetVar(\"cursor\");
bool ih_ablate_previous = ih_cfg->GetVar(\"ablate_previous\");
bool ih_ablate_induction = ih_cfg->GetVar(\"ablate_induction\");
if(ih_n < 5) ih_n = 5;
if(ih_n > 32) ih_n = 32;
if(ih_v < 4) ih_v = 4;
if(ih_v > 16) ih_v = 16;
if(ih_temp < 0.02) ih_temp = 0.02;
if(ih_temp > 5.0) ih_temp = 5.0;
if(ih_noise < 0.0) ih_noise = 0.0;
if(ih_noise > 1.0) ih_noise = 1.0;
if(ih_seed < 1) ih_seed = 1;
if(ih_seed > 1000000) ih_seed = 1000000;
if(ih_cursor < 1) ih_cursor = 1;
if(ih_cursor >= ih_n) ih_cursor = ih_n - 1;
ih_cfg->SetVar(\"sequence_length\", ih_n);
ih_cfg->SetVar(\"vocabulary_size\", ih_v);
ih_cfg->SetVar(\"temperature\", ih_temp);
ih_cfg->SetVar(\"noise\", ih_noise);
ih_cfg->SetVar(\"seed\", ih_seed);
ih_cfg->SetVar(\"cursor\", ih_cursor);
// Park-Miller RNG using Schrage's overflow-free integer recurrence.
// Fisher-Yates chooses a fresh vocabulary permutation for each seed.
int_Matrix ih_permutation;
ih_permutation.SetGeom(1, ih_v);
int ih_rng = ih_seed;
int ih_a;
for(ih_a = 0; ih_a < ih_v; ih_a++) ih_permutation[ih_a] = ih_a;
for(ih_a = ih_v - 1; ih_a > 0; ih_a--) {
  ih_rng = 16807 * (ih_rng % 127773) - 2836 * (ih_rng / 127773);
  if(ih_rng <= 0) ih_rng += 2147483647;
  int ih_swap = ih_rng % (ih_a + 1);
  int ih_tmp = ih_permutation[ih_a];
  ih_permutation[ih_a] = ih_permutation[ih_swap];
  ih_permutation[ih_swap] = ih_tmp;
}
int ih_period = ih_n / 2;
if(ih_period > ih_v - 1) ih_period = ih_v - 1;
ih_sequence->RemoveAllRows();
ih_sequence->AddRows(ih_n);
for(ih_a = 0; ih_a < ih_n; ih_a++) {
  int ih_token = ih_permutation[ih_a % ih_period];
  // Keep the first exemplar and final query intact. Corrupt intermediate
  // repetitions with the held-out distractor token at the requested rate.
  ih_rng = 16807 * (ih_rng % 127773) - 2836 * (ih_rng / 127773);
  if(ih_rng <= 0) ih_rng += 2147483647;
  double ih_draw = ih_rng / 2147483647.0;
  if(ih_a >= ih_period && ih_a < ih_n - 1 && ih_draw < ih_noise)
    ih_token = ih_permutation[ih_v - 1];
  ih_sequence->SetVal(ih_a, \"position\", ih_a);
  ih_sequence->SetVal(ih_token, \"token\", ih_a);
  ih_sequence->SetVal(String(ih_token), \"label\", ih_a);
  int ih_next_token = ih_permutation[(ih_a + 1) % ih_period];
  ih_sequence->SetVal(ih_next_token, \"next_token\", ih_a);
}
ih_cursor = ih_n - 1;
ih_cfg->SetVar(\"cursor\", ih_cursor);
// Exact constructed two-head attention circuit. Head 1 copies the previous
// token embedding into a separate key subspace. Head 2 compares the current
// token query to that subspace, applies a causal softmax and copies values.
int_Matrix ih_tokens;
float_Matrix ih_embeddings;
float_Matrix ih_keys;
float_Matrix ih_attention;
float_Matrix ih_values;
float_Matrix ih_prediction;
ih_tokens.SetGeom(1, ih_n);
ih_embeddings.SetGeom(2, ih_n, ih_v);
ih_keys.SetGeom(2, ih_n, ih_v);
ih_attention.SetGeom(2, ih_n, ih_n);
ih_values.SetGeom(2, ih_n, ih_v);
ih_prediction.SetGeom(1, ih_v);
ih_embeddings.InitVals(0.0);
ih_keys.InitVals(0.0);
ih_attention.InitVals(0.0);
ih_values.InitVals(0.0);
ih_prediction.InitVals(0.0);
int ih_i;
int ih_j;
int ih_k;
for(ih_i = 0; ih_i < ih_n; ih_i++) {
  ih_tokens[ih_i] = ih_sequence->GetVal(\"token\", ih_i);
  if(ih_tokens[ih_i] < 0 || ih_tokens[ih_i] >= ih_v) {
    ih_cfg->SetVar(\"status\", \"Token outside vocabulary. Generate a new sequence.\");
    ret_val = -1;
    return;
  }
  int ih_current_token = ih_tokens[ih_i];
  ih_embeddings[ih_i, ih_current_token] = 1.0;
  if(ih_i > 0 && !ih_ablate_previous) {
    int ih_previous_token = ih_tokens[ih_i - 1];
    ih_keys[ih_i, ih_previous_token] = 1.0;
  }
}
for(ih_i = 1; ih_i < ih_n; ih_i++) {
  double ih_total = 0.0;
  int ih_query_token = ih_tokens[ih_i];
  // j=0 has no predecessor key. The standard causal mask permits j<=i;
  // every future source j>i remains exactly zero.
  for(ih_j = 1; ih_j <= ih_i; ih_j++) {
    double ih_match = ih_keys[ih_j, ih_query_token];
    double ih_weight = exp((ih_match - 1.0) / ih_temp);
    ih_attention[ih_j, ih_i] = ih_weight;
    ih_total += ih_weight;
  }
  for(ih_j = 1; ih_j <= ih_i; ih_j++)
    ih_attention[ih_j, ih_i] = ih_attention[ih_j, ih_i] / ih_total;
}
for(ih_j = 1; ih_j <= ih_cursor; ih_j++) {
  double ih_mass = ih_attention[ih_j, ih_cursor];
  if(ih_ablate_induction) ih_mass = 0.0;
  int ih_value_token = ih_tokens[ih_j];
  ih_values[ih_j, ih_value_token] = ih_mass;
  ih_prediction[ih_value_token] += ih_mass;
}
int ih_predicted = -1;
double ih_best = 0.0;
for(ih_k = 0; ih_k < ih_v; ih_k++) {
  if(ih_prediction[ih_k] > ih_best) {
    ih_best = ih_prediction[ih_k];
    ih_predicted = ih_k;
  }
}
int ih_target = ih_sequence->GetVal(\"next_token\", ih_cursor);
ih_cfg->SetVar(\"prediction\", ih_predicted);
ih_cfg->SetVar(\"target\", ih_target);
ih_cfg->SetVar(\"confidence\", ih_best);
ih_cfg->SetVar(\"status\", \"Query \" + String(ih_tokens[ih_cursor]) +
  \" at position \" + String(ih_cursor) + \" predicts \" + String(ih_predicted) +
  \"; repeated-pattern target \" + String(ih_target));

// Keep inspectable DataTable matrices and real Network unit state in sync.
bool ih_resize_table = ih_states->data.size != 5;
if(!ih_resize_table) {
  DataCol* ih_first_column = ih_states->data[0];
  ih_resize_table = ih_first_column->cell_geom.dim(0) != ih_n ||
                    ih_first_column->cell_geom.dim(1) != ih_v;
}
if(ih_resize_table) {
  ih_states->RemoveAllCols();
  ih_states->NewColMatrix(DataCol::VT_FLOAT, \"TokenEmbeddings\", 2, ih_n, ih_v);
  ih_states->NewColMatrix(DataCol::VT_FLOAT, \"PreviousTokenKeys\", 2, ih_n, ih_v);
  ih_states->NewColMatrix(DataCol::VT_FLOAT, \"CausalAttention\", 2, ih_n, ih_n);
  ih_states->NewColMatrix(DataCol::VT_FLOAT, \"CopiedValues\", 2, ih_n, ih_v);
  ih_states->NewColMatrix(DataCol::VT_FLOAT, \"Prediction\", 1, ih_v);
  ih_states->AddRows(1);
 }
ih_states->SetValAsMatrix(ih_embeddings, \"TokenEmbeddings\", 0);
ih_states->SetValAsMatrix(ih_keys, \"PreviousTokenKeys\", 0);
ih_states->SetValAsMatrix(ih_attention, \"CausalAttention\", 0);
ih_states->SetValAsMatrix(ih_values, \"CopiedValues\", 0);
ih_states->SetValAsMatrix(ih_prediction, \"Prediction\", 0);

Layer* ih_token_layer = ih_net->layers[\"Token_Embeddings\"];
Layer* ih_key_layer = ih_net->layers[\"Previous_Token_Keys\"];
Layer* ih_query_layer = ih_net->layers[\"Current_Query\"];
Layer* ih_attn_layer = ih_net->layers[\"Causal_Attention\"];
Layer* ih_value_layer = ih_net->layers[\"Copied_Values\"];
Layer* ih_pred_layer = ih_net->layers[\"Next_Token_Prediction\"];
if(ih_token_layer->un_geom.x != ih_n || ih_token_layer->un_geom.y != ih_v ||
   ih_token_layer->n_units_built == 0) {
  ih_token_layer->SetLayerUnitGeom(ih_n, ih_v);
  ih_key_layer->SetLayerUnitGeom(ih_n, ih_v);
  ih_query_layer->SetLayerUnitGeom(1, ih_v);
  ih_attn_layer->SetLayerUnitGeom(ih_n, ih_n);
  ih_value_layer->SetLayerUnitGeom(ih_n, ih_v);
  ih_pred_layer->SetLayerUnitGeom(1, ih_v);
  ih_token_layer->SetAbsPos(0, 0, 0);
  ih_key_layer->SetAbsPos(0, ih_v + 3, 3);
  ih_query_layer->SetAbsPos(ih_n + 4, ih_v + 3, 3);
  ih_attn_layer->SetAbsPos(0, 2 * (ih_v + 3), 6);
  ih_value_layer->SetAbsPos(0, 2 * (ih_v + 3) + ih_n + 4, 9);
  ih_pred_layer->SetAbsPos(ih_n + 4, 2 * (ih_v + 3) + ih_n + 4, 12);
  ih_net->Build();
  ih_net->Init_Weights();
}
for(ih_i = 0; ih_i < 6; ih_i++) {
  Layer* ih_label_layer = ih_net->layers[ih_i];
  ih_label_layer->SetUnitNames(true);
}
for(ih_j = 0; ih_j < ih_n; ih_j++) {
  for(ih_k = 0; ih_k < ih_v; ih_k++) {
    ih_token_layer->GetUnitFlatXY(ih_j, ih_k)->act = ih_embeddings[ih_j, ih_k];
    ih_key_layer->GetUnitFlatXY(ih_j, ih_k)->act = ih_keys[ih_j, ih_k];
    ih_value_layer->GetUnitFlatXY(ih_j, ih_k)->act = ih_values[ih_j, ih_k];
    String ih_label = String(ih_j) + \":\" + String(ih_k);
    ih_token_layer->SetUnitNameIdx(ih_k * ih_n + ih_j, ih_label);
    ih_key_layer->SetUnitNameIdx(ih_k * ih_n + ih_j, ih_label);
    ih_value_layer->SetUnitNameIdx(ih_k * ih_n + ih_j, ih_label);
  }
  for(ih_i = 0; ih_i < ih_n; ih_i++) {
    ih_attn_layer->GetUnitFlatXY(ih_j, ih_i)->act = ih_attention[ih_j, ih_i];
    ih_attn_layer->SetUnitNameIdx(ih_i * ih_n + ih_j, String(ih_i) + \"<-\" + String(ih_j));
  }
}
for(ih_k = 0; ih_k < ih_v; ih_k++) {
  ih_query_layer->GetUnitIdx(ih_k)->act = (ih_k == ih_tokens[ih_cursor]);
  ih_pred_layer->GetUnitIdx(ih_k)->act = ih_prediction[ih_k];
  ih_query_layer->SetUnitNameIdx(ih_k, String(ih_k));
  ih_pred_layer->SetUnitNameIdx(ih_k, String(ih_k));
}
ih_net->UpdateAllViews();
ih_states->UpdateAllViews();
ih_sequence->UpdateAllViews();
if(taMisc::gui_active) {
  NetView* ih_view = ih_net->FindMakeView();
  ih_view->lay_layout = NetView::THREE_D;
  ih_view->unit_disp_mode = NetView::UDM_BLOCK;
  ih_view->unit_text_disp = NetView::UTD_NONE;
  ih_view->display = true;
  ih_view->font_sizes.layer = 0.0;
  ih_view->font_sizes.layer_min = 0.0;
  ih_view->font_sizes.net_name = 0.0;
  T3Panel* ih_frame = ih_view->GetFrame();
  ih_frame->SetColorScheme(T3Panel::WHITE_ON_BLACK);
  ih_frame->bg_color.Set(0.035, 0.055, 0.11);
  ih_frame->text_color.Set(0.86, 0.93, 1.0);
  ih_frame->UpdateAfterEdit();
  ih_net->SetViewVar(\"act\");
  ih_view->SetScaleData(false, 0.0, 1.0);
  // These annotations connect computational stages; they are not Bp synapses.
  ih_view->annotations.Reset();
  ih_view->AnnoteEndArrow(true, ih_n / 2.0, ih_v + 0.5, 0,
    0, 2.5, 3, 3.0, \"#22d3ee\", 0.018);
  ih_view->AnnoteEndArrow(true, ih_n / 2.0, 2 * ih_v + 3.5, 3,
    0, 2.5, 3, 3.0, \"#a78bfa\", 0.018);
  ih_view->AnnoteEndArrow(true, ih_n + 4, ih_v + 3, 3,
    -4, ih_v + 3, 3, 3.0, \"#fbbf24\", 0.018);
  ih_view->AnnoteEndArrow(true, ih_n / 2.0, 2 * (ih_v + 3) + ih_n + 0.5, 6,
    0, 3.5, 3, 3.0, \"#60a5fa\", 0.018);
  ih_view->AnnoteEndArrow(true, ih_n + 0.5, 2 * (ih_v + 3) + ih_n + 4 + ih_v / 2.0, 9,
    3.5, 0, 3, 3.0, \"#34d399\", 0.018);
  // Existing annotation rotations keep stage labels facing the saved camera.
  T3Annotation* ih_label_0 = ih_view->AnnoteText(true, \"01  Token embeddings\",
    0, -4, 0, 0.055, T3DataViewMain::LEFT, \"#cffafe\");
  ih_label_0->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_0->UpdateAfterEdit();
  T3Annotation* ih_label_1 = ih_view->AnnoteText(true, \"02  Previous-token keys\",
    0, ih_v - 1, 3, 0.055, T3DataViewMain::LEFT, \"#ddd6fe\");
  ih_label_1->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_1->UpdateAfterEdit();
  T3Annotation* ih_label_2 = ih_view->AnnoteText(true, \"03  Query\",
    ih_n + 3, ih_v - 1, 3, 0.045, T3DataViewMain::LEFT, \"#fde68a\");
  ih_label_2->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_2->UpdateAfterEdit();
  T3Annotation* ih_label_3 = ih_view->AnnoteText(true, \"04  Causal attention\",
    0, 2 * (ih_v + 3) - 4, 6, 0.055, T3DataViewMain::LEFT, \"#bfdbfe\");
  ih_label_3->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_3->UpdateAfterEdit();
  T3Annotation* ih_label_4 = ih_view->AnnoteText(true, \"05  Copied values\",
    0, 2 * (ih_v + 3) + ih_n, 9, 0.055, T3DataViewMain::LEFT, \"#a7f3d0\");
  ih_label_4->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_4->UpdateAfterEdit();
  T3Annotation* ih_label_5 = ih_view->AnnoteText(true, \"06  Prediction\",
    ih_n + 2, 2 * (ih_v + 3) + ih_n, 12, 0.045, T3DataViewMain::LEFT, \"#a7f3d0\");
  ih_label_5->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_5->UpdateAfterEdit();
  T3Annotation* ih_label_6 = ih_view->AnnoteText(true, \"INDUCTORHEAD | MATCH -> COPY\",
    0, 2 * (ih_v + 3) + ih_n + ih_v + 7, 12, 0.05, T3DataViewMain::LEFT, \"#67e8f9\");
  ih_label_6->rot.SetXYZR(1, 0, 0, -0.62);
  ih_label_6->UpdateAfterEdit();
  ih_view->UpdateDisplay();
  // Tilt the camera toward the token grids and frame all six stages.
  ih_frame->SaveCurView(0);
  ih_frame->SetCameraOrient(0, 1, 0, 0, -0.62);
  ih_frame->SetCameraPos(0, 0.55, 1.828, 1.241);
  ih_frame->SetCameraFocDist(0, 2.2);
  ih_frame->GoToSavedView(0);
  ih_frame->SaveCurView(0);
  ih_project->ctrl_panels[\"Laboratory\"]->EditPanel(true, true);
  MainWindowViewer* ih_browser = ih_project->GetDefaultProjectViewer();
  if(ih_browser != NULL) {
    // Existing saved-window geometry leaves room for the existing CSS console.
    ih_browser->SetUserData(\"view_win_lft\", 0.01);
    ih_browser->SetUserData(\"view_win_top\", 0.01);
    ih_browser->SetUserData(\"view_win_wd\", 0.98);
    ih_browser->SetUserData(\"view_win_ht\", 0.78);
    ih_browser->SetWinState();
    ih_browser->ViewWindow();
  }
}

cout << \"INDUCTOR \" << ih_cfg->GetVar(\"status\") << endl;
";
     };
    };
   };
   step_prog=NULL;
   step_n=1;
