-    dVector3 dim;
-
-    ccdGeomToObj(g, (ccd_obj_t *)box);
-
-    dGeomBoxGetLengths(g, dim);
-    box->dim[0] = (ccd_real_t)(dim[0] * 0.5);
-    box->dim[1] = (ccd_real_t)(dim[1] * 0.5);
-    box->dim[2] = (ccd_real_t)(dim[2] * 0.5);
-}
