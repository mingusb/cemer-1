-                        break;
-                    }
-                    dxJoint *j = *_jcurr++;
-                    j->getInfo1 (&jicurr->info);
-                    dIASSERT (/*jicurr->info.m >= 0 && */jicurr->info.m <= 6 && /*jicurr->info.nub >= 0 && */jicurr->info.nub <= jicurr->info.m);
-                    if (jicurr->info.m != 0) {
-                        mcurr += jicurr->info.m;
