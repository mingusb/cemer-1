-            dQMultiply1( qq, node[1].body->q, qcross2 );
-            dQMultiply2( qrel, qq, qrel2 );
-        }
-        else
-        {
-            // pretend joint->node[1].body->q is the identity
-            dQMultiply2( qrel, qcross2, qrel2 );
-        }
-
-        *angle2 = - getHingeAngleFromRelativeQuat( qrel, axis2 );
-    }
-    else
-    {
-        *angle1 = 0;
-        *angle2 = 0;
-    }
-}
