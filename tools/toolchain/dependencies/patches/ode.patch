+
+dxJointBall::dxJointBall( dxWorld *w ) :
+    dxJoint( w )
+{
+    dSetZero( anchor1, 4 );
+    dSetZero( anchor2, 4 );
+    erp = world->global_erp;
+    cfm = world->global_cfm;
+}
+
+
+void 
+dxJointBall::getSureMaxInfo( SureMaxInfo* info )
+{
+    info->max_m = 3;
+}
