-{
-    unsigned j,k;
-    dIASSERT (/*nC >= 0 && nN >= 0 && */(nC + nN) == i && i < n);
-    for (k=0; k<i; k++) dIASSERT (p[k] >= 0 && p[k] < i);
-    for (k=i; k<n; k++) dIASSERT (p[k] == k);
-    for (j=0; j<nC; j++) {
-        int C_is_bad = 1;
-        for (k=0; k<nC; k++) if (C[k]==j) C_is_bad = 0;
-        dIASSERT (C_is_bad==0);
-    }
-}
