-        dCalcVectorCross3( ltd, c, axis );
-        dBodyAddTorque ( joint->node[0].body, ltd[0], ltd[1], ltd[2] );
-
-
-        dMultiply0_331 ( c, joint->node[1].body->posr.R, joint->anchor2 );
-        dCalcVectorCross3( ltd, c, axis );
-        dBodyAddTorque ( joint->node[1].body, ltd[0], ltd[1], ltd[2] );
-    }
-}
