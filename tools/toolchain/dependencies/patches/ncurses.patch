diff --git a/filter-version-map.py b/filter-version-map.py
new file mode 100644
index 0000000..192a06f
--- /dev/null
+++ b/filter-version-map.py
@@ -0,0 +1,28 @@
+#!/usr/bin/env python3
+"""Restrict an aggregate ELF version map to a particular shared library.
+
+The ncurses maps combine exports from separate libraries and optional features.
+Keep version nodes, inheritance and wildcards, but omit exact names which this
+library's input objects do not define. This preserves each real export's ABI
+version while allowing linkers to check every explicit export.
+"""
+import pathlib
+import re
+import subprocess
+import sys
+
+source, destination, *objects = sys.argv[1:]
+output = subprocess.check_output(
+    ["nm", "--defined-only", "--extern-only", "--format=posix", *objects], text=True)
+symbols = {line.split()[0] for line in output.splitlines()
+           if len(line.split()) >= 3 and not line.endswith(":")}
+lines = []
+for line in pathlib.Path(source).read_text().splitlines(keepends=True):
+    match = re.fullmatch(r"\s*([A-Za-z_.$][A-Za-z_0-9.$]*)\s*;\s*\n?", line)
+    if match and match.group(1) not in symbols:
+        continue
+    lines.append(line)
+path = pathlib.Path(destination)
+temporary = path.with_name(path.name + ".tmp")
+temporary.write_text("".join(lines))
+temporary.replace(path)
