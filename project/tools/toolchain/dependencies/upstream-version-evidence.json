  "libsndfile": {
    "url": "https://raw.githubusercontent.com/libsndfile/libsndfile/b9103bd48b6c8fb517ae737fe3baee0c718b804c/CMakeLists.txt",
    "version_lines": [
      "cmake_minimum_required (VERSION 3.5...4.0)",
      "\tif (CMAKE_VERSION VERSION_LESS 3.18)",
      "project(libsndfile VERSION 1.2.2)",
      "set (CPACK_PACKAGE_VERSION_MAJOR ${PROJECT_VERSION_MAJOR})",
      "set (CPACK_PACKAGE_VERSION_MINOR ${PROJECT_VERSION_MINOR})",
      "set (CPACK_PACKAGE_VERSION_PATCH ${PROJECT_VERSION_PATCH})",
      "set (CPACK_PACKAGE_VERSION_STAGE \"\")",
      "set (CPACK_PACKAGE_VERSION_FULL \"${PROJECT_VERSION}${CPACK_PACKAGE_VERSION_STAGE}\")",
      "if (CMAKE_VERSION VERSION_LESS 3.14)",
      "\tset (VERSION ${PROJECT_VERSION})",
      "\t# ABI version of library.",
      "\t# Read libtool version from `configure.ac` and set libsndfile ABI version:",
      "\t#   SNDFILE_ABI_VERSION_MAJOR",
      "\t#   SNDFILE_ABI_VERSION_MINOR",
      "\t#   SNDFILE_ABI_VERSION_PATCH",
      "\t#   SNDFILE_ABI_VERSION",
      "\t# and Mach-O current and compatibility versions:",
      "\t#   SNDFILE_MACHO_CURRENT_VERSION",
      "\t#   SNDFILE_MACHO_COMPATIBILITY_VERSION",
      "\tsetup_abi_versions()",
      "\t\tset (VERSION_MAJOR ${CPACK_PACKAGE_VERSION_MAJOR})",
      "\t\tset (WIN_RC_VERSION \"${CPACK_PACKAGE_VERSION_MAJOR},${CPACK_PACKAGE_VERSION_MINOR},${CPACK_PACKAGE_VERSION_PATCH}\")",
      "\t\tset (CLEAN_VERSION \"${CPACK_PACKAGE_VERSION_MAJOR}.${CPACK_PACKAGE_VERSION_MINOR}.${CPACK_PACKAGE_VERSION_PATCH}\")",
      "\t\tset (PACKAGE_VERSION ${CPACK_PACKAGE_VERSION})",
      "\t\tconfigure_file (src/version-metadata.rc.in src/version-metadata.rc @ONLY)",
      "\t\ttarget_sources (sndfile PRIVATE ${PROJECT_BINARY_DIR}/src/version-metadata.rc)",
      "\t\tSOVERSION ${SNDFILE_ABI_VERSION_MAJOR}",
      "\t\tVERSION ${SNDFILE_ABI_VERSION}",
      "\t\tif (NOT (CMAKE_VERSION VERSION_LESS 3.17))",
      "\t\t\t\tMACHO_CURRENT_VERSION ${SNDFILE_MACHO_CURRENT_VERSION}",
      "\t\t\t\tMACHO_COMPATIBILITY_VERSION ${SNDFILE_MACHO_COMPATIBILITY_VERSION}",
      "\t\t\tCOMMAND ${Python_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/src/create_symbols_file.py ${SYMBOL_OS} ${SNDFILE_ABI_VERSION} > ${CMAKE_CURRENT_BINARY_DIR}/src/${SYMBOL_FILENAME}",
      "\t\t\tif (CMAKE_VERSION VERSION_LESS 3.13)",
      "\t\t\tif (CMAKE_VERSION VERSION_LESS 3.13)",
      "\t\t\tif (CMAKE_VERSION VERSION_LESS 3.13)"
