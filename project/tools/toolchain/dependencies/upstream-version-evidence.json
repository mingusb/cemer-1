  "ncurses": {
    "url": "https://raw.githubusercontent.com/ThomasDickey/ncurses-snapshots/797a8eb3303f9145bf87c9d16b187a3b63c262b5/dist.mk",
    "version_lines": [
      "# configure mines the current version number out of here.  To move",
      "# to a new version number, just edit this file and run configure.",
      "# These define the major/minor/patch versions of ncurses.",
      "# We don't append the patch to the version, since this only applies to releases",
      "VERSION = $(NCURSES_MAJOR).$(NCURSES_MINOR)",
      "# versions of 'man' leave no margin (and make it harder to sync with pages).",
      "\t(cd ..;  tar cvf ncurses-$(VERSION).tar `sed <ncurses-$(VERSION)/MANIFEST 's/^./ncurses-$(VERSION)/'`;  gzip ncurses-$(VERSION).tar)",
      "\t\t-e 's,@VERSION@,$(VERSION),g' \\"
