  "cmake": {
    "url": "https://raw.githubusercontent.com/Kitware/CMake/5440cd9785ffa9c48a60c5b3ee28f7d0ffd045c6/Source/CMakeVersion.cmake",
    "version_lines": [
      "# CMake version number components.",
      "set(CMake_VERSION_MAJOR 4)",
      "set(CMake_VERSION_MINOR 4)",
      "set(CMake_VERSION_PATCH 20260913)",
      "#set(CMake_VERSION_RC 0)",
      "set(CMake_VERSION_IS_DIRTY 0)",
      "# Start with the full version number used in tags.  It has no dev info.",
      "set(CMake_VERSION",
      "  \"${CMake_VERSION_MAJOR}.${CMake_VERSION_MINOR}.${CMake_VERSION_PATCH}\")",
      "if(DEFINED CMake_VERSION_RC)",
      "  string(APPEND CMake_VERSION \"-rc${CMake_VERSION_RC}\")",
      "if(\"${CMake_VERSION_PATCH}\" VERSION_LESS 20000000)",
      "  set(CMake_VERSION_IS_RELEASE 1)",
      "  set(CMake_VERSION_IS_RELEASE 0)",
      "if(NOT CMake_VERSION_NO_GIT)",
      "  # Otherwise, try to identify the current development source version.",
      "    if(NOT \"${git_subject}\" MATCHES \"^[Cc][Mm]ake ${CMake_VERSION}$\")",
      "      string(APPEND CMake_VERSION \"-g${git_hash}\")",
      "        set(CMake_VERSION_IS_DIRTY 1)",
      "    if(NOT CMake_VERSION_IS_RELEASE)",
      "      # Generic development version.",
      "      string(APPEND CMake_VERSION \"-git\")",
      "# Extract the version suffix component.",
      "if(CMake_VERSION MATCHES \"-(.*)$\")",
      "  set(CMake_VERSION_SUFFIX \"${CMAKE_MATCH_1}\")",
      "  set(CMake_VERSION_SUFFIX \"\")",
      "if(CMake_VERSION_IS_DIRTY)",
      "  string(APPEND CMake_VERSION \"-dirty\")"
    ]
  },
  "ninja": {
    "url": "https://raw.githubusercontent.com/ninja-build/ninja/0f507b509621ed96171efa35332ce6e74fa0e08c/src/version.cc",
    "version_lines": [
      "#include \"version.h\"",
      "void ParseVersion(const string& version, int* major, int* minor) {",
      "  size_t end = version.find('.');",
      "  *major = atoi(version.substr(0, end).c_str());",
      "    end = version.find('.', start);",
      "    *minor = atoi(version.substr(start, end).c_str());",
      "void CheckNinjaVersion(const string& version, int* file_major,",
      "  ParseVersion(version, file_major, file_minor);",
      "    Warning(\"ninja executable version (%s) greater than build file \"",
      "            \"ninja_required_version (%s); versions may be incompatible.\",",
      "            kNinjaVersion, version.c_str());",
      "    Fatal(\"ninja version (%s) incompatible with build file \"",
      "          \"ninja_required_version version (%s).\",",
      "          kNinjaVersion, version.c_str());"
    ]
  },
