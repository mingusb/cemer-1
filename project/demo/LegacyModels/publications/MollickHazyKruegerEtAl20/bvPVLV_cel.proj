      ControlPanelMember @[1] {
       label="blamyg_pos_d1_units_dt_net_tau";
       short_label=0;
       cust_label=0;
       desc="[Default: 1.4]  net input time constant in cycles, which should be milliseconds typically (roughly, how long it takes for value to change significantly -- 1.4x the half-life) -- this is important for damping oscillations -- generally reflects time constants associated with synaptic channels which are not modeled in the most abstract rate code models (set to 1 for detailed spiking models with more realistic synaptic currents)";
       cust_desc=0;
       base=$.networks[0].specs.gp[0][0].children[8].dt$;
