     data {ctrl_type=CLUSTER_RUN: is_numeric=0: is_single=1: state=STABLE: saved_value=".active_params.gp[\"PVLVParams\"][\"PVLVMaster\"]": range="": notes="": };
    };
    ControlPanelMember @[3] {
