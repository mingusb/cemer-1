    };
    ControlPanelMember @[4] {
     label="stable_params";
     short_label=1;
     cust_label=0;
     desc="select pvlv parameters";
     cust_desc=0;
     base=$.programs.gp[1][2].vars[5]$;
     mbr=ProgVar::object_val;
     data {ctrl_type=CONTROL: is_numeric=0: is_single=1: state=EXPLORE: saved_value=".active_params.gp[\"PVLVStable\"][\"PVLVStableMaster\"]": range="": notes="generally shouldn't have to mess..": };
    };
    ControlPanelMember @[5] {
     label="misc_params";
     short_label=1;
     cust_label=0;
     desc="select other parameters, typically network spec params -- independent of run params";
     cust_desc=0;
     base=$.programs.gp[1][2].vars[3]$;
     mbr=ProgVar::object_val;
     data {ctrl_type=CONTROL: is_numeric=0: is_single=1: state=EXPLORE: saved_value=".projects[\"bvPVLV_cel_ror\"].active_params.gp[\"MiscParams\"][\"MiscMaster\"]": range="": notes="misc params -- network specs": };
    };
    ControlPanelMember @[6] {
     label="analysis_params";
     short_label=1;
     cust_label=0;
