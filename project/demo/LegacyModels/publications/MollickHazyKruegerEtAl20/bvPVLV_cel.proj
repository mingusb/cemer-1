    ControlPanelMember_Group @.gp[3] {
     name="AntiOscillationTimeConstants";
     el_typ=ControlPanelMember;
     el_def=0;
     ControlPanelMember @[0] {
      label="blamyg_pos_d1_units_dt_vm_tau";
      short_label=0;
      cust_label=0;
      desc="[Default: 2.81:10]  [3.3 std for rate code, 2.81 for spiking] membrane potential and rate-code activation time constant in cycles, which should be milliseconds typically (roughly, how long it takes for value to change significantly -- 1.4x the half-life) -- reflects the capacitance of the neuron in principle -- biological default for AeEx spiking model C = 281 pF = 2.81 normalized -- for rate-code activation, this also determines how fast to integrate computed activation values over time";
      cust_desc=0;
      base=$.networks[0].specs.gp[0][0].children[8].dt$;
      mbr=LeabraDtSpec::vm_tau;
      data {ctrl_type=PARAM_SET: is_numeric=1: is_single=1: state=STABLE: saved_value="5": range="": notes="": };
     };
     ControlPanelMember @[1] {
      label="blamyg_pos_d1_units_dt_net_tau";
      short_label=0;
      cust_label=0;
      desc="[Default: 1.4]  net input time constant in cycles, which should be milliseconds typically (roughly, how long it takes for value to change significantly -- 1.4x the half-life) -- this is important for damping oscillations -- generally reflects time constants associated with synaptic channels which are not modeled in the most abstract rate code models (set to 1 for detailed spiking models with more realistic synaptic currents)";
      cust_desc=0;
      base=$.networks[0].specs.gp[0][0].children[8].dt$;
      mbr=LeabraDtSpec::net_tau;
      data {ctrl_type=PARAM_SET: is_numeric=1: is_single=1: state=STABLE: saved_value="3": range="": notes="": };
     };
     ControlPanelMember @[2] {
      label="blamyg_neg_d1_units_dt_vm_tau";
      short_label=0;
      cust_label=0;
