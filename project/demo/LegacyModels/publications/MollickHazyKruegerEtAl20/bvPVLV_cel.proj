       data {ctrl_type=PARAM_SET: is_numeric=1: is_single=1: state=STABLE: saved_value="1": range="": notes="gain factor applied to excitatory drive from the quasi-NoGo VSMatrix layer; ultimately, drives phasic DA dips and is THE input that drives X- DA dips; 1": };
      };
      ControlPanelMember @[5] {
       label="lhb_rmtg_units_gains_vspatch_neg__d2";
