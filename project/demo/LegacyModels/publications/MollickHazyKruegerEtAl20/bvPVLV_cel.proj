       data {ctrl_type=PARAM_SET: is_numeric=1: is_single=1: state=STABLE: saved_value="1": range="": notes="gain factor applied to inhibitory drive from the appetitive VSMatrix layer; ultimately, drives phasic DA bursts, but is redundant to the trans-amygdala LVe pathway; 1, 0.7": };
      };
      ControlPanelMember @[4] {
       label="lhb_rmtg_units_gains_vsmatrix_pos__d2";
