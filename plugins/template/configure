#!/usr/bin/env bash
# Configure a generated emergent plugin using the app's Clang / Qt 6 environment.
set -euo pipefail
source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
build_dir=build
plugin_type=User
clean=false
cmake_args=()
usage() {
  cat <<'HELP'
Usage: ./configure [options]
  --debug                     Debug build (default: RelWithDebInfo)
  --prefix=User|System        Plugin installation scope (default: User)
  --suffix=NAME               Extra application/library suffix
  --mpi                       Enable MPI
  --build-dir=PATH            Build directory (default: build)
  --generator=NAME, -G NAME   CMake generator, for example Ninja
  --qtdir=PATH                Qt 6 SDK prefix (otherwise use CMAKE_PREFIX_PATH)
  --qt6                       Qt 6 is required and selected by default
  --clean                     Remove the selected build directory's CMake cache
  --verbose                   Verbose build output
  --not-native                Portable CPU settings (the default)
  --sse8                      Enable the application's 8-way SIMD option
  --yes                       Accepted for compatibility; configuration never prompts
  -DNAME=VALUE                Additional CMake option

Source the same compiler/Qt environment used for emergent first.
Set EMERGENT_PREFIX_DIR to the emergent installation prefix when needed.
HELP
}
while (($#)); do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --debug|--enable-debug|-d) cmake_args+=(-DCMAKE_BUILD_TYPE=Debug); build_dir=build_dbg ;;
    --prefix=*) plugin_type=${1#*=} ;;
    --suffix=*) cmake_args+=("-DEXTRA_SUFFIX=${1#*=}") ;;
    --mpi|--enable-mpi) cmake_args+=(-DMPI_BUILD=ON) ;;
    --build-dir=*) build_dir=${1#*=} ;;
    --generator=*) cmake_args+=(-G "${1#*=}") ;;
    -G) shift; cmake_args+=(-G "${1:?missing generator after -G}") ;;
    --qtdir=*) cmake_args+=("-DQTDIR=${1#*=}") ;;
    --qt6|--yes|-y) ;;
    --clean) clean=true ;;
    --verbose|--verbose-build|-v) cmake_args+=(-DCMAKE_VERBOSE_MAKEFILE=ON) ;;
    --not-native) cmake_args+=(-DEMERGENT_NATIVE_ARCH=OFF) ;;
    --sse8) cmake_args+=(-DCMAKE_CXX_FLAGS=-DUSE_SSE8) ;;
    --qt4|--qt5|--c++11) printf '%s\n' 'This plugin requires Qt 6 and C++17 or newer.' >&2; exit 2 ;;
    -D*=*) cmake_args+=("$1") ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
case "$plugin_type" in User|System) ;; *) printf '%s\n' '--prefix must be User or System' >&2; exit 2 ;; esac
if [[ $build_dir != /* ]]; then build_dir="$source_dir/$build_dir"; fi
if $clean; then
  rm -f -- "$build_dir/CMakeCache.txt"
  rm -rf -- "$build_dir/CMakeFiles"
fi
cmake -S "$source_dir" -B "$build_dir" "-DEMERGENT_PLUGIN_TYPE=$plugin_type" "${cmake_args[@]}"
printf 'Build:   cmake --build %q\nInstall: cmake --install %q\n' "$build_dir" "$build_dir"
